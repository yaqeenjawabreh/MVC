@{
}

<h2>Review Request</h2>

<table class="table">
    <thead>
        <tr>
            <th>Supplier</th>
            <th>Offer</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in new[] { "C", "H", "G" })
        {
            <tr>
                <td>@ViewData[p + "Supplier"]</td>
                <td>@ViewData[p + "Offer"]</td>
                <td>@ViewData[p + "Quantity"]</td>
                <td>@ViewData[p + "UnitPrice"] JD</td>
                <td>@ViewData[p + "Total"] JD</td>
            </tr>
        }
    </tbody>
</table>

<p>Total Price: @ViewBag.TotalPrice JD</p>
<p>Discount: @ViewBag.DiscountPercentage %</p>
<p>Discount Amount: @ViewBag.DiscountAmount JD</p>
<h3>Final Total: @ViewBag.FinalTotal JD</h3>

<a href="@Url.Action("SupplyRequest")">Back to Supply Request</a>