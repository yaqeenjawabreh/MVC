@using AcademyGraduationCeremonySupplyManagementSystem.Models
@model List<OfferNew>
@{
    ViewData["Title"] = "Review Request";
}

<h1>Review Request</h1>

<table class="table">
    <thead>
        <tr>
            <th>Category</th>
            <th>Supplier</th>
            <th>Offer Name</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Total Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Category</td>
                <td>@item.Supply</td>
                <td>@item.OfferName</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice JD</td>
                <td>@item.Total JD</td>
            </tr>
        }
    </tbody>
</table>

<p><strong>Total Price:</strong> @ViewBag.Total JD</p>
<p><strong>Discount Percentage:</strong> @ViewBag.DiscountPercentage %</p>
<p><strong>Discount Amount:</strong> @ViewBag.DiscountAmount JD</p>
<h3>Final Total: @ViewBag.FinalTotal JD</h3>

<a href="@Url.Action("SupplyRequest", "GCSM")">Back to Supply Request</a>