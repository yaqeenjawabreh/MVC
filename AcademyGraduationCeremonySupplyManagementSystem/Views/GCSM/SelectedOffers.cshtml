@using AcademyGraduationCeremonySupplyManagementSystem.Models
@model OfferNew
@{
    ViewData["Title"] = "Selected Offer";
}

<h1>Offer Selected</h1>

<table class="table">
    <tr><th>Category</th><td>@Model.Category</td></tr>
    <tr><th>Supplier</th><td>@Model.Supply</td></tr>
    <tr><th>Offer Name</th><td>@Model.OfferName</td></tr>
    <tr><th>Quantity</th><td>@Model.Quantity</td></tr>
    <tr><th>Unit Price</th><td>@Model.UnitPrice JD</td></tr>
</table>

<a href="@Url.Action("SupplyRequest", "GCSM")" class="btn btn-primary">Select Another Offer</a>
<a href="@Url.Action("ReviewRequest", "GCSM")" class="btn btn-success">Review Request</a>