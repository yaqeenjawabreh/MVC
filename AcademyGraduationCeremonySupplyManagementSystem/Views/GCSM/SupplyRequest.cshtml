@using AcademyGraduationCeremonySupplyManagementSystem.Models;
@model List<OfferNew>
@{
    ViewData["Title"] = "Create Supply Request";
}

<h1>Create Supply Request</h1>
<p>Select one offer from each category.</p>

@if (TempData["Error"] != null)
{
    <p style="color:red">@TempData["Error"]</p>
}

@foreach (var category in new[] { "GraduationCertificates", "Hospitality", "GraduationGifts" })
{
    <h2>@category</h2>
    <table class="table">
        <thead>
            <tr>
                <th>Supplier</th>
                <th>Offer Name</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                if (item.Category == category)
                {
                    <tr>
                        <td>@item.Supply</td>
                        <td>@item.OfferName</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitPrice JD</td>
                        <td>
                            <a class="btn btn-primary btn-sm"
                               href="@Url.Action("SelectedOffers", "GCSM", new { id = item.OfferId })">Select</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

<a href="@Url.Action("ReviewRequest", "GCSM")" class="btn btn-success">Review Request</a>