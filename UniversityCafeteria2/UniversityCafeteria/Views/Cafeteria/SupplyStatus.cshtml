    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = null;
}
@{
    var Supply = new[] {
        new { Product = "Water", Supplier = "Fresh Food Company", Quantity = 100, Status = "Available" },
        new { Product = "Orange Juice", Supplier = "Happy Drinks Company", Quantity = 20, Status = "Low Stock" },
        new { Product = "Coffee", Supplier = "Daily Supplies Company", Quantity = 50, Status = "Available" },
        new { Product = "Sandwich", Supplier = "Fresh Food Company", Quantity = 0, Status = "Out of Stock" },
        new { Product = "Chocolate", Supplier = "Daily Supplies Company", Quantity = 30, Status = "Available" }
    };}
<html>
<head>
    <title>Supply Status</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/SupplyStatus.css" rel="stylesheet" />
</head>
<body>
     <nav class="navbar navbar-expand-lg navbar-dark bg-dark ">
        <div class="container">
            <a class="navbar-brand" asp-controller="Cafeteria" asp-action="Index">University Cafeteria</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cafeteria" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cafeteria" asp-action="Products">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cafeteria" asp-action="Suppliers">Suppliers</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cafeteria" asp-action="SupplyStatus">Supply Status</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <h1>Supply Status</h1>
    <p>This is a simple supply status page.</p>
    <table class="table table-striped">
        <thead class="thead-dark">
            <tr>
                
                <th scope="col">Product</th>
                <th scope="col">Supplier</th>
                <th scope="col">Quantity</th>
                <th scope="col">Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Supply)
            {
                <tr>
                    <td>@item.Product</td>
                    <td>@item.Supplier</td>
                    <td>@item.Quantity</td>
                    <td>
                        @if (item.Status == "Out of Stock")
                        {
                            <span class="badge bg-danger">@item.Status</span>
                        }
                        else if (item.Status == "Low Stock")
                        {
                            <span class="badge bg-warning text-dark">@item.Status</span>
                        }
                        else if (item.Status == "Available")
                        {
                            <span class="badge bg-success">@item.Status</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>