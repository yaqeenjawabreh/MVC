<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <title>@ViewBag.Title</title>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark ">
        <div class="container">
            <a class="navbar-brand" asp-controller="Cafeteria" asp-action="Index">University Cafeteria</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cafeteria" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cafeteria" asp-action="Products">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cafeteria" asp-action="Suppliers">Suppliers</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cafeteria" asp-action="SupplyStatus">Supply Status</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Supply" asp-action="index">Home(supplyController) </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Supply" asp-action="Products">Products(supplyController)</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Supply" asp-action="Suppliers">Suppliers(SupplyController)</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Supply" asp-action="CreateRequest">Create Request </a>
                    </li> 
                  <li class="nav-item">
                        <a class="nav-link" asp-controller="Supply" asp-action="About">About</a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>
<main>
    <div class="container">
        @RenderBody()
    </div>
    @RenderSection("Scripts", required: false)
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
