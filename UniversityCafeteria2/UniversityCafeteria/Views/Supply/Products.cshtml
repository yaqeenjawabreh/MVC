@{
}
<div class="container">
    <div class="card">@ViewData["PageTitle"]</div>
<div class="card">@ViewData["ManagerName"]</div>
<div class="card">@ViewData["NumberOfProducts"]</div>
<div class="card">
    <ul>
        @foreach (string product in (string[])ViewData["Products"])
        {
            <li>@product</li>
        }
    </ul>
</div>
</div>