@{
}

<div class="container">
    <div class="card">@ViewBag.PageTitle</div>
    <div class="card">Number of Suppliers: @ViewBag.NumberOfSuppliers</div>
    <div class="card">
        <ul>
            @foreach (string company in ViewBag.Companys)
            {
                <li>@company</li>
            }
        </ul>
    </div>
</div>
