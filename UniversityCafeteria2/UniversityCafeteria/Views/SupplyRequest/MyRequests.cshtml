@{
    Layout = "~/Views/Shared/_SupplyRequest.cshtml";
}
@using UniversityCafeteria.Models
@{
    var requests = ViewBag.Requests as List<SupplyRequest>;
}

@if (TempData["msg"] != null)
{
    <div class="alert alert-success">@TempData["msg"]</div>
}

<h3>My Supply Requests</h3>

@if (requests == null || requests.Count == 0)
{
    <p>No confirmed requests yet.</p>
}
else
{
    <table class="table">
        <tr>
            <th>Request ID</th>
            <th>Products</th>
            <th>Subtotal</th>
            <th>Preparation Fee</th>
            <th>Discount</th>
            <th>Final Total</th>
            <th>Status</th>
        </tr>
        @foreach (var r in requests)
        {
            <tr>
                <td>@r.RequestId</td>
                <td>@r.Items.Count</td>
                <td>@r.Subtotal JD</td>
                <td>@r.PreparationFee JD</td>
                <td>@r.Discount JD</td>
                <td>@r.FinalTotal JD</td>
                <td>@r.Status</td>
            </tr>
        }
    </table>
}