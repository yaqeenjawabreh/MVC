@using task6.Models;
@model IEnumerable<Category>
 <a href="@Url.Action("Create", "Category")" class="btn btn-primary">Create New Category</a>
<table class="table"> 
    <thead>
        <tr>
             <th>ID</th>

            <th>Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {  
               <tr>
                <td>@category.Id</td>   
                <td>@category.Name</td>
                 
            </tr>
        }
    </tbody>
</table>
