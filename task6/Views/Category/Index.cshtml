@using task6.Models;
@model IEnumerable<Category>
 <a href="@Url.Action("Create", "Category")" class="btn btn-primary lg-m-3 ">Create New Category</a>
<table class="table"> 
    <thead>
        <tr>
             <th>ID</th>
            <th>Name</th>
            <th>Description</th>
            <th>Action</th>
            <th>Prodect Number</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {  
               <tr>
                <td>@category.Id</td>   
                <td>@category.Name</td>
                <td>@category.Description</td>
             <td>
                 <a href="@Url.Action("Edit","Category",new{id=category.Id})" class="btn btn-primary m-2">Edit</a> 
                 <a href="@Url.Action("Details", "Category", new { id = category.Id })" class="btn btn-secondary m-2">Details</a>
                 <a href="@Url.Action("Delete", "Category", new { id = category.Id })" class="btn btn-danger m-2" onclick="return confirm(' Are you Sure you want to delete this @category.Name category?')">Delete</a>

             </td>
              <td>@category.Products.Count</td>
         </tr>
        }
       
    </tbody>
</table>
