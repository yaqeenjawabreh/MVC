@using task6.Models;
@model Employee

<h2>Create New Employee</h2>
@using (Html.BeginForm("Create", "Employee", FormMethod.Post))
{
    <div class="mb-3">
        @Html.LabelFor(model => model.FullName)
        @Html.TextBoxFor(model => model.FullName, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.Phone)
        @Html.TextBoxFor(model => model.Phone, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.Email)
        @Html.TextBoxFor(model => model.Email, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.Position)
        @Html.TextBoxFor(model => model.Position, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.Salary)
        @Html.TextBoxFor(model => model.Salary, new { @class = "form-control", type = "number", step = "0.01" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.HierDate)
        @Html.TextBoxFor(model => model.HierDate, new { @class = "form-control", type = "date" })
    </div>
    <div>
        <input type="submit" value="Create" class="btn btn-primary" />
    </div>
}
<br />
<a href="@Url.Action("Index", "Employee")" class="btn btn-dark">Back to List</a>