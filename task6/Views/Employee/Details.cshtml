@{
}
@model Employee

<h2>Employee Details</h2>
<hr />
<h3>ID: @Model.Id</h3>
<h3>Full Name: @Model.FullName</h3>
<h3>Phone: @Model.Phone</h3>
<h3>Email: @Model.Email</h3>
<h3>Position: @Model.Position</h3>
<h3>Salary: @Model.Salary</h3>
<h3>Hire Date: @Model.HierDate.ToShortDateString()</h3>
<h3>Total Orders Handled: @(Model.Orders != null ? Model.Orders.Count : 0)</h3>

<br />
<a href="@Url.Action("Index", "Employee")" class="btn btn-dark">Back to List</a>