@{
}
@model Employee

<h2>Edit Employee</h2>
<form method="post" action="@Url.Action("Edit")">
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="mb-3">
        <label>Full Name</label>
        <input type="text" name="FullName" value="@Model.FullName" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Phone</label>
        <input type="number" name="Phone" value="@Model.Phone" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Email</label>
        <input type="text" name="Email" value="@Model.Email" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Position</label>
        <input type="text" name="Position" value="@Model.Position" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Salary</label>
        <input type="number" step="0.01" name="Salary" value="@Model.Salary" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Hire Date</label>
        <input type="date" name="HierDate" value="@Model.HierDate.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>
<br />
<a href="@Url.Action("Index", "Employee")" class="btn btn-dark">Back to List</a>