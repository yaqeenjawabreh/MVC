@{
}
@using task6.Models;
@model IEnumerable<Employee>

<a href="@Url.Action("Create", "Employee")" class="btn btn-primary mb-3">Create New Employee</a>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Full Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Position</th>
            <th>Salary</th>
            <th>Hire Date</th>
            <th>Orders Handled Count</th> 
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emp in Model)
        {
            <tr>
                <td>@emp.Id</td>
                <td>@emp.FullName</td>
                <td>@emp.Phone</td>
                <td>@emp.Email</td>
                <td>@emp.Position</td>
                <td>@emp.Salary</td>
                <td>@emp.HierDate.ToShortDateString()</td>
                <td>@(emp.Orders != null ? emp.Orders.Count : 0)</td>
                <td>
                    <a href="@Url.Action("Edit", "Employee", new { id = emp.Id })" class="btn btn-primary btn-sm">Edit</a>
                    <a href="@Url.Action("Details", "Employee", new { id = emp.Id })" class="btn btn-secondary btn-sm">Details</a>
                    <a href="@Url.Action("Delete", "Employee", new { id = emp.Id })" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete @emp.FullName?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
