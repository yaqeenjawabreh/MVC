@{
}
@using task6.Models;
@model Order

<h2>Create New Order</h2>
@using (Html.BeginForm("Create", "Order", FormMethod.Post))
{
    <div class="mb-3">
        @Html.LabelFor(model => model.CustomerName)
        @Html.TextBoxFor(model => model.CustomerName, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.OrderDate)
        @Html.TextBoxFor(model => model.OrderDate, new { @class = "form-control", type = "date" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.TotalPrice)
        @Html.TextBoxFor(model => model.TotalPrice, new { @class = "form-control", type = "number", step = "0.01" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.Status)
        @Html.TextBoxFor(model => model.Status, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        <label>Employee</label>
        <select name="EmployeeId" class="form-control">
            @foreach (var emp in ViewBag.Employees)
            {
                <option value="@emp.Id">@emp.FullName</option>
            }
        </select>
    </div>
    <div>
        <input type="submit" value="Create" class="btn btn-primary" />
    </div>
}
<br />
<a href="@Url.Action("Index", "Order")" class="btn btn-dark">Back to List</a>