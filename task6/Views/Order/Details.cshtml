@{
}
@model Order

<h2>Order Details</h2>
<hr />
<h3>Order ID: @Model.Id</h3>
<h3>Customer Name: @Model.CustomerName</h3>
<h3>Order Date: @(Model.OrderDate.HasValue ? Model.OrderDate.Value.ToShortDateString() : "N/A")</h3>
<h3>Total Price: @Model.TotalPrice</h3>
<h3>Status: @Model.Status</h3>
<h3>Employee: @(Model.Employee != null ? Model.Employee.FullName : "N/A")</h3>

<br />
<a href="@Url.Action("Index", "Order")" class="btn btn-dark">Back to List</a>