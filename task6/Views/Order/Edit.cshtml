@{
}
@model Order

<h2>Edit Order</h2>
<form method="post" action="@Url.Action("Edit")">
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="mb-3">
        <label>Customer Name</label>
        <input type="text" name="CustomerName" value="@Model.CustomerName" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Order Date</label>
        <input type="date" name="OrderDate" value="@(Model.OrderDate.HasValue ? Model.OrderDate.Value.ToString("yyyy-MM-dd") : "")" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Total Price</label>
        <input type="number" step="0.01" name="TotalPrice" value="@Model.TotalPrice" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Status</label>
        <input type="text" name="Status" value="@Model.Status" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Employee</label>
        <select name="EmployeeId" class="form-control">
            @foreach (var emp in ViewBag.Employees)
            {
                if (emp.Id == Model.EmployeeId)
                {
                    <option value="@emp.Id" selected="selected">@emp.FullName</option>
                }
                else
                {
                    <option value="@emp.Id">@emp.FullName</option>
                }
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>
<br />
<a href="@Url.Action("Index", "Order")" class="btn btn-dark">Back to List</a>