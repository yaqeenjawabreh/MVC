    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@using task6.Models;
@model IEnumerable<Order>

<a href="@Url.Action("Create", "Order")" class="btn btn-primary mb-3">Create New Order</a>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Customer Name</th>
            <th>Order Date</th>
            <th>Total Price</th>
            <th>Status</th>
            <th>Employee</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.CustomerName</td>
                <td>@(order.OrderDate.HasValue ? order.OrderDate.Value.ToShortDateString() : "N/A")</td>
                <td>@order.TotalPrice</td>
                <td>@order.Status</td>
                <td>@(order.Employee != null ? order.Employee.FullName : "N/A")</td>
                <td>
                    <a href="@Url.Action("Edit", "Order", new { id = order.Id })" class="btn btn-primary btn-sm">Edit</a>
                    <a href="@Url.Action("Details", "Order", new { id = order.Id })" class="btn btn-secondary btn-sm">Details</a>
                    <a href="@Url.Action("Delete", "Order", new { id = order.Id })" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete order #@order.Id?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
