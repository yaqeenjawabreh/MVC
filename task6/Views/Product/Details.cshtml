@{
}
@* For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860 *@
@model Product

<h2>Product Details</h2>
<hr />
<h3>Product Id: @Model.Id</h3>
<h3>Product Name: @Model.Name</h3>
<h3>Price: @Model.Price</h3>
<h3>Quantity: @Model.Quantity</h3>
<h3>Category: @(Model.Category != null ? Model.Category.Name : "N/A")</h3>
<h3>Supplier: @(Model.Supplier != null ? Model.Supplier.Name : "N/A")</h3>

<br>
<a href="@Url.Action("Index", "Product")" class="btn btn-dark">Back to List</a>