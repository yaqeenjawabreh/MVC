@using task6.Models;
@model IEnumerable<Product>
<a href="@Url.Action("Create", "Product")" class="btn btn-primary">Create New Product</a>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Category</th>
            <th>Supplier</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Price</td>
                <td>@product.Quantity</td>
                <td>@product.CategoryId</td>
                <td>@product.SupplierId</td>
            </tr>
        }
    </tbody>
</table>