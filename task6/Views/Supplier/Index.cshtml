@using task6.Models;
@model IEnumerable<Supplier>

<a href="@Url.Action("Create", "Supplier")" class="btn btn-primary">Create New Supplier</a>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supplier in Model)
        {
            <tr>
                <td>@supplier.Id</td>
                <td>@supplier.Name</td>
                <td>@supplier.phone</td>
                <td>@supplier.Email</td>    

            </tr>
        }
    </tbody>
</table>
