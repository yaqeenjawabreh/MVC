@using task6.Models;
@model IEnumerable<Supplier>

<a href="@Url.Action("Create", "Supplier")" class="btn btn-primary">Create New Supplier</a>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Action</th>
            <th>Product Number</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supplier in Model)
        {
            <tr>
                <td>@supplier.Id</td>
                <td>@supplier.Name</td>
                <td>@supplier.phone</td>
                <td>@supplier.Email</td>   
                <td>
                    <a href="@Url.Action("Edit","Supplier",new{id=supplier.Id})" class="btn btn-primary m-2">Edit</a> 
<a href="@Url.Action("Details", "Supplier", new { id = supplier.Id })" class="btn btn-secondary m-2">Details</a>
<a href="@Url.Action("Delete", "Supplier", new { id = supplier.Id })" class="btn btn-danger m-2" onclick="return confirm(' Are you Sure you want to delete this @supplier.Name supplier?')">Delete</a>

                    </td>
                <td>@supplier.Products.Count</td>
            </tr>
        }
    </tbody>
</table>
